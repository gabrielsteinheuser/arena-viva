# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Para o Supabase local, use a saída de `npx supabase status`.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional: mostra a LP desta arena na raiz do site (ex.: domínio próprio da arena).
# VITE_DEFAULT_ARENA_SLUG=arena-viva
